{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Advisor Match LangGraph — Decision Workflow",
    "subtitle": "Explicit routing, bounded model decisions, deterministic matching, interrupts, review, and workbook publication",
    "output": "docs/advisor_match_langgraph_workflow.html",
    "animation": "none",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "viewBox": [900, 1100],
    "views": [
      {
        "id": "match_path",
        "label": "New match path",
        "focus": ["user_turn", "route", "inspect", "map_input", "validate", "match", "persist", "response"],
        "note": "A new attachment follows this fixed path unless mapping or firm evidence requires clarification."
      },
      {
        "id": "clarifications",
        "label": "Clarification loops",
        "focus": ["map_input", "mapping_pause", "validate", "match", "firm_pause"],
        "note": "Mapping answers bypass routing; firm answers select explicit workflow actions through routing."
      },
      {
        "id": "review_controls",
        "label": "Review and controls",
        "focus": ["route", "review_commands", "other_routes", "persist", "response"],
        "note": "Review, manual CRD, approval, status, reset, and guidance stay on bounded branches."
      }
    ]
  },
  "lanes": [
    { "id": "interaction", "label": "User + UI" },
    { "id": "llm", "label": "Bounded LLM Decisions" },
    { "id": "commands", "label": "Explicit Command Branches" },
    { "id": "deterministic", "label": "Deterministic Matching Logic" },
    { "id": "human", "label": "Interrupt + Human Input", "variant": "exception" },
    { "id": "output", "label": "Audit + Artifact Output" }
  ],
  "phases": [
    { "id": "intake", "label": "Intake + route", "fromCol": 0, "toCol": 1 },
    { "id": "interpret", "label": "Inspect + interpret", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "execute", "label": "Validate + execute", "fromCol": 4, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": ["user_turn", "route", "inspect", "map_input", "validate", "match", "persist", "response"],
  "nodes": [
    { "id": "user_turn", "lane": "interaction", "col": 0, "type": "external", "label": "User Turn", "sublabel": "text + optional file", "tag": "thread_id", "width": 108 },
    { "id": "response", "lane": "interaction", "col": 5, "type": "frontend", "label": "Chat Response", "sublabel": "text + progress events", "width": 126 },

    { "id": "route", "lane": "llm", "col": 1, "type": "backend", "label": "route", "sublabel": "typed intent + firm", "tag": "LLM · 3 tries", "width": 120 },
    { "id": "map_input", "lane": "llm", "col": 3, "type": "backend", "label": "map_input", "sublabel": "sheet + header + columns", "tag": "bounded profile", "width": 132 },

    { "id": "review_commands", "lane": "commands", "col": 1, "type": "backend", "label": "Review Commands", "sublabel": "review + CRD proposal", "width": 132 },
    { "id": "other_routes", "lane": "commands", "col": 3, "type": "backend", "label": "Other Routes", "sublabel": "approve · status · reset · help", "width": 146 },

    { "id": "inspect", "lane": "deterministic", "col": 2, "type": "backend", "label": "inspect", "sublabel": "bounded file preview", "width": 116 },
    { "id": "validate", "lane": "deterministic", "col": 4, "type": "security", "label": "validate", "sublabel": "bindings + fingerprint", "tag": "code-owned", "width": 112 },
    { "id": "match", "lane": "deterministic", "col": 5, "type": "security", "label": "match", "sublabel": "candidates + decisions", "tag": "no row LLM", "width": 112 },

    { "id": "mapping_pause", "lane": "human", "col": 4, "type": "messagebus", "label": "Mapping Pause", "sublabel": "interrupt → resolve", "width": 110 },
    { "id": "firm_pause", "lane": "human", "col": 5, "type": "messagebus", "label": "Firm Pause", "sublabel": "column · firm · continue", "width": 110 },

    { "id": "persist", "lane": "output", "col": 5, "type": "database", "label": "Persist + Export", "sublabel": "audit + verified workbook", "width": 138 }
  ],
  "edges": [
    { "id": "turn_to_route", "from": "user_turn", "to": "route", "role": "main", "variant": "emphasis" },

    { "id": "route_start", "from": "route", "to": "inspect", "label": "start_match", "role": "main" },
    { "id": "route_review", "from": "route", "to": "review_commands", "label": "review / manual CRD", "role": "branch" },
    { "id": "route_other", "from": "route", "to": "other_routes", "label": "other typed route", "role": "branch" },

    { "id": "inspect_profile", "from": "inspect", "to": "map_input", "label": "bounded profile", "role": "main" },
    { "id": "inspect_stop", "from": "inspect", "to": "response", "label": "file needed / invalid", "role": "error", "variant": "security" },

    { "id": "mapping_ready", "from": "map_input", "to": "validate", "label": "complete mapping", "role": "main" },
    { "id": "mapping_question", "from": "map_input", "to": "mapping_pause", "label": "ambiguous", "role": "branch", "variant": "security" },
    { "id": "mapping_resume", "from": "mapping_pause", "to": "validate", "label": "yes / resolved details", "role": "return", "variant": "emphasis" },

    { "id": "validation_ok", "from": "validate", "to": "match", "label": "valid", "role": "main" },
    { "id": "validation_stop", "from": "validate", "to": "response", "label": "actionable error", "role": "error", "variant": "security" },

    { "id": "firm_question", "from": "match", "to": "firm_pause", "label": "firm evidence needed", "role": "branch", "variant": "security" },
    { "id": "firm_resume", "from": "firm_pause", "to": "match", "label": "route → remap or match", "role": "return", "variant": "emphasis" },
    { "id": "match_persist", "from": "match", "to": "persist", "label": "match created", "role": "main", "variant": "emphasis" },

    { "id": "review_persist", "from": "review_commands", "to": "persist", "label": "decision applied", "role": "branch" },
    { "id": "review_response", "from": "review_commands", "to": "response", "label": "page / proposal / cancel", "role": "branch" },
    { "id": "other_persist", "from": "other_routes", "to": "persist", "label": "approve", "role": "branch" },
    { "id": "other_response", "from": "other_routes", "to": "response", "label": "status / reset / guidance", "role": "branch" },

    { "id": "artifact_response", "from": "persist", "to": "response", "label": "reply + artifact event", "role": "main", "variant": "emphasis" }
  ],
  "cards": [
    {
      "dot": "violet",
      "title": "LLM Decisions",
      "items": [
        "route classifies only the current request and extracts explicit firm instructions",
        "map_input interprets a bounded upload profile into a typed mapping",
        "Mapping resume uses the pending question, current answer, proposal, and bounded profile",
        "Every structured model decision has at most three total attempts"
      ]
    },
    {
      "dot": "emerald",
      "title": "Deterministic Decisions",
      "items": [
        "Code validates files, exact column bindings, row limits, hashes, and fingerprints",
        "Code owns normalization, candidate generation, scoring, identity decisions, and duplicates",
        "Code resolves review row numbers and protects internal IDs",
        "Code regenerates and verifies every published workbook revision"
      ]
    },
    {
      "dot": "amber",
      "title": "Human Gates",
      "items": [
        "A mapping yes accepts a stored proposal without calling the general router",
        "Unresolved mapping details return only to the bounded mapping interpreter",
        "Firm answers choose an exact column, all-row firm, source values, or weaker evidence",
        "An unlisted CRD requires display and explicit confirmation in a later user turn"
      ]
    },
    {
      "dot": "slate",
      "title": "State + Recovery",
      "items": [
        "InMemorySaver checkpoints are scoped by corporation and conversation thread_id",
        "A new attachment deletes only that conversation checkpoint and starts fresh",
        "Different thread_id values can run concurrently under the same corporation",
        "API restart intentionally loses conversation progress and pending interrupts"
      ]
    }
  ]
}
