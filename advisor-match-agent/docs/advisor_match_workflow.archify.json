{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Advisor Matching Workflow",
    "subtitle": "Flexible interpretation, deterministic matching, and conversational exception review",
    "animation": "none",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "output": "docs/advisor_match_workflow.html",
    "viewBox": [1200, 900]
  },
  "lanes": [
    { "id": "interaction", "label": "User + Streamlit" },
    { "id": "orchestration", "label": "Deep Agent" },
    { "id": "deterministic", "label": "Typed Deterministic Code" },
    { "id": "storage", "label": "Protected State" },
    { "id": "audit", "label": "Session + Audit" },
    { "id": "export", "label": "Verified Export" }
  ],
  "phases": [
    { "id": "intake", "label": "Upload", "fromCol": 0, "toCol": 0 },
    { "id": "interpret", "label": "Interpret", "fromCol": 1, "toCol": 1, "variant": "emphasis" },
    { "id": "preflight", "label": "Validate", "fromCol": 2, "toCol": 2, "variant": "security" },
    { "id": "matching", "label": "Snapshot + match", "fromCol": 3, "toCol": 3, "variant": "emphasis" },
    { "id": "review", "label": "Review", "fromCol": 4, "toCol": 4 },
    { "id": "deliver", "label": "Export", "fromCol": 5, "toCol": 5, "variant": "dashed" }
  ],
  "groups": [
    { "id": "agent_work", "label": "Model interprets and explains", "lane": "orchestration", "fromCol": 1, "toCol": 4, "variant": "emphasis" },
    { "id": "code_work", "label": "Code validates and decides", "lane": "deterministic", "fromCol": 2, "toCol": 3, "variant": "security" }
  ],
  "mainPath": ["upload", "interpret_upload", "validate_mapping", "reference_snapshot", "match_rows", "review_items", "workbook", "results"],
  "nodes": [
    { "id": "upload", "lane": "interaction", "col": 0, "type": "external", "label": "Upload", "sublabel": "CSV or XLSX" },
    { "id": "clarify", "lane": "interaction", "col": 2, "type": "security", "label": "Clarify", "sublabel": "ask user" },
    { "id": "results", "lane": "interaction", "col": 5, "type": "frontend", "label": "Results", "sublabel": "review + download" },
    { "id": "interpret_upload", "lane": "orchestration", "col": 1, "type": "backend", "label": "Interpret", "sublabel": "profile + map" },
    { "id": "review_items", "lane": "orchestration", "col": 4, "type": "messagebus", "label": "Review", "sublabel": "small pages" },
    { "id": "validate_mapping", "lane": "deterministic", "col": 2, "type": "security", "label": "Validate", "sublabel": "fingerprint", "width": 72 },
    { "id": "match_rows", "lane": "deterministic", "col": 3, "type": "backend", "label": "Run Match", "sublabel": "snapshot first", "width": 72 },
    { "id": "reference_snapshot", "lane": "storage", "col": 3, "type": "database", "label": "Snapshot", "sublabel": "immutable", "width": 64 },
    { "id": "session", "lane": "audit", "col": 4, "type": "database", "label": "Session", "sublabel": "audit", "width": 64 },
    { "id": "workbook", "lane": "export", "col": 5, "type": "database", "label": "Workbook", "sublabel": "styled + verified" }
  ],
  "edges": [
    { "id": "upload_interpret", "from": "upload", "to": "interpret_upload", "role": "main" },
    { "id": "interpret_validate", "from": "interpret_upload", "to": "validate_mapping", "role": "main", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "id": "validate_clarify", "from": "validate_mapping", "to": "clarify", "role": "error", "variant": "security", "route": "straight" },
    { "id": "clarify_interpret", "from": "clarify", "to": "interpret_upload", "role": "return", "variant": "dashed", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "id": "validate_snapshot", "from": "validate_mapping", "to": "reference_snapshot", "role": "main" },
    { "id": "snapshot_match", "from": "reference_snapshot", "to": "match_rows", "role": "main", "variant": "emphasis", "route": "straight" },
    { "id": "match_review", "from": "match_rows", "to": "review_items", "role": "main", "variant": "emphasis", "fromSide": "top", "toSide": "bottom", "route": "up-channel" },
    { "id": "review_session", "from": "review_items", "to": "session", "role": "branch", "variant": "dashed" },
    { "id": "review_workbook", "from": "review_items", "to": "workbook", "role": "main" },
    { "id": "session_workbook", "from": "session", "to": "workbook", "role": "branch", "variant": "dashed" },
    { "id": "workbook_results", "from": "workbook", "to": "results", "role": "main", "variant": "emphasis", "route": "straight" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Agent boundary",
      "items": [
        "Interprets bounded raw rows",
        "Asks when evidence is unclear",
        "Explains qualitative review pages",
        "Never decides identities row by row"
      ]
    },
    {
      "dot": "emerald",
      "title": "Code boundary",
      "items": [
        "Validates exact column references",
        "Applies the versioned match policy",
        "Stores snapshots, decisions, and audit",
        "Regenerates and verifies the workbook"
      ]
    }
  ]
}
