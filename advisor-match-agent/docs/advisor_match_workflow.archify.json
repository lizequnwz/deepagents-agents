{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Advisor Matching Workflow",
    "subtitle": "A bounded LangGraph run that clarifies input, matches deterministically, and ends with a verified workbook",
    "output": "docs/advisor_match_workflow.html",
    "animation": "none",
    "visual_preset": "blueprint",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "complete_run",
        "label": "Complete matching run",
        "focus": ["upload", "route", "prepare", "match", "publish"],
        "note": "Follow one upload through bounded interpretation, deterministic matching, and workbook publication."
      },
      {
        "id": "clarifications",
        "label": "Pre-match clarifications",
        "focus": ["prepare", "mapping_question", "firm_question", "match"],
        "note": "Only unresolved column meaning or firm context can pause the graph."
      },
      {
        "id": "offline_review",
        "label": "Offline review boundary",
        "focus": ["match", "publish", "download"],
        "note": "The graph stops after export; review and local edits happen in the downloaded workbook."
      }
    ]
  },
  "lanes": [
    { "id": "user", "label": "User + Streamlit" },
    { "id": "control", "label": "LangGraph Control" },
    { "id": "matching", "label": "Deterministic Matching" },
    { "id": "output", "label": "Verified Output" },
    { "id": "mapping_help", "label": "Mapping Clarification", "variant": "exception" },
    { "id": "firm_help", "label": "Firm Clarification", "variant": "exception" },
    { "id": "boundary", "label": "Outside Application", "variant": "exception" }
  ],
  "phases": [
    { "id": "request", "label": "Request", "fromCol": 0, "toCol": 1 },
    { "id": "prepare_phase", "label": "Interpret + validate", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "execute", "label": "Match + deliver", "fromCol": 4, "toCol": 5, "variant": "security" }
  ],
  "mainPath": ["upload", "route", "prepare", "match", "publish"],
  "nodes": [
    { "id": "upload", "lane": "user", "col": 0, "type": "frontend", "label": "Upload", "sublabel": "CSV/XLSX" },
    { "id": "route", "lane": "control", "col": 1, "type": "backend", "label": "Route", "sublabel": "typed intent", "tag": "max 3 attempts" },
    { "id": "prepare", "lane": "matching", "col": 2, "type": "security", "label": "Prepare", "sublabel": "inspect · map · check", "tag": "bounded" },
    { "id": "match", "lane": "matching", "col": 4, "type": "backend", "label": "Match", "sublabel": "policy owned", "tag": "deterministic" },
    { "id": "publish", "lane": "output", "col": 5, "type": "database", "label": "Publish", "sublabel": "verified XLSX", "tag": "graph ends" },
    { "id": "mapping_question", "lane": "mapping_help", "col": 3, "type": "messagebus", "label": "Map Question", "sublabel": "interrupt + resume" },
    { "id": "firm_question", "lane": "firm_help", "col": 4, "type": "messagebus", "label": "Firm Question", "sublabel": "interrupt + resume" },
    { "id": "download", "lane": "boundary", "col": 5, "type": "external", "label": "Review Copy", "sublabel": "local Excel", "tag": "not re-ingested" }
  ],
  "edges": [
    { "from": "upload", "to": "route" },
    { "from": "route", "to": "prepare", "route": "drop", "fromSide": "bottom", "toSide": "top" },
    { "from": "prepare", "to": "match", "route": "straight" },
    { "from": "match", "to": "publish" },
    { "from": "prepare", "to": "mapping_question", "variant": "security", "role": "error" },
    { "from": "mapping_question", "to": "prepare", "variant": "dashed", "role": "return" },
    { "from": "match", "to": "firm_question", "variant": "security", "role": "error" },
    { "from": "firm_question", "to": "match", "variant": "dashed", "role": "return" },
    { "from": "publish", "to": "download", "label": "user-owned copy", "variant": "dashed" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Deterministic Core",
      "items": [
        "Code owns validation, candidate generation, scoring, and match decisions",
        "The model routes intent and helps interpret ambiguous input structure",
        "No model chooses advisors row by row"
      ]
    },
    {
      "dot": "amber",
      "title": "Only Pre-Match Interrupts",
      "items": [
        "Column meaning can pause before validation",
        "Missing or unrecognized firm context can pause before matching",
        "A new attachment resets the in-memory graph state"
      ]
    },
    {
      "dot": "cyan",
      "title": "Workbook Is the Handoff",
      "items": [
        "Matched and Review Required sheets explain automated outcomes",
        "Users may edit their downloaded copy for downstream work",
        "Local edits are not sent back to or validated by the application"
      ]
    }
  ]
}
