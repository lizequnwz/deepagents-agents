{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Advisor Match Agent Workflow",
    "subtitle": "One attachment snapshot, compact exact indexes, and audited workbook revisions",
    "output": "docs/advisor_match_workflow.html",
    "animation": "none",
    "visual_preset": "signal-flow",
    "quality_profile": "showcase",
    "viewBox": [720, 820]
  },
  "lanes": [
    { "id": "interaction", "label": "User + Streamlit" },
    { "id": "storage", "label": "Protected Storage + SQLite" },
    { "id": "agent", "label": "Bounded Agent Reasoning" },
    { "id": "deterministic", "label": "Deterministic Application Code" }
  ],
  "phases": [
    { "id": "intake", "label": "Immutable intake", "fromCol": 0, "toCol": 1, "variant": "security" },
    { "id": "interpret", "label": "Map", "fromCol": 2, "toCol": 2, "variant": "emphasis" },
    { "id": "resolve", "label": "Resolve + review", "fromCol": 3, "toCol": 4 },
    { "id": "deliver", "label": "Verify + publish", "fromCol": 5, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": ["upload", "attachment", "interpret_input", "reference_snapshot", "match_rows", "publish_artifact", "download"],
  "nodes": [
    { "id": "upload", "lane": "interaction", "col": 0, "type": "external", "label": "Upload", "sublabel": "one CSV or XLSX" },
    { "id": "download", "lane": "interaction", "col": 5, "type": "frontend", "label": "Download", "sublabel": "verified workbook" },
    { "id": "clarify", "lane": "interaction", "col": 3, "type": "external", "label": "Clarify", "sublabel": "mapping or evidence" },
    { "id": "interpret_input", "lane": "agent", "col": 2, "type": "backend", "label": "Interpret", "sublabel": "profile + map", "tag": "bounded samples" },
    { "id": "review", "lane": "agent", "col": 4, "type": "backend", "label": "Review", "sublabel": "explicit choices" },
    { "id": "reference_snapshot", "lane": "deterministic", "col": 2, "type": "cloud", "label": "Snapshot", "sublabel": "once per attachment", "width": 82 },
    { "id": "match_rows", "lane": "deterministic", "col": 4, "type": "backend", "label": "Match", "sublabel": "exact index + policy v4", "tag": "deterministic", "width": 96 },
    { "id": "attachment", "lane": "storage", "col": 2, "type": "database", "label": "Attachment", "sublabel": "ID + SHA-256" },
    { "id": "publish_artifact", "lane": "storage", "col": 5, "type": "database", "label": "Publish", "sublabel": "artifact + audit IDs", "tag": "explicit" }
  ],
  "edges": [
    { "id": "store_upload", "from": "upload", "to": "attachment", "role": "main", "variant": "security" },
    { "id": "profile_attachment", "from": "attachment", "to": "interpret_input", "role": "main", "variant": "emphasis", "fromSide": "top", "toSide": "bottom", "route": "straight" },
    { "id": "request_clarification", "from": "interpret_input", "to": "clarify", "role": "branch", "variant": "dashed", "fromSide": "right", "toSide": "bottom", "via": [[430, 367]] },
    { "id": "retrieve_reference", "from": "interpret_input", "to": "reference_snapshot", "role": "main", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "id": "run_match", "from": "reference_snapshot", "to": "match_rows", "role": "main", "variant": "emphasis" },
    { "id": "open_review", "from": "match_rows", "to": "review", "role": "branch", "fromSide": "top", "toSide": "bottom", "route": "drop" },
    { "id": "publish_initial", "from": "match_rows", "to": "publish_artifact", "role": "main", "variant": "security", "fromSide": "right", "toSide": "bottom", "via": [[625, 491]] },
    { "id": "deliver_artifact", "from": "publish_artifact", "to": "download", "role": "main", "variant": "emphasis", "fromSide": "top", "toSide": "bottom", "route": "drop" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Minimal File Model",
      "items": [
        "Uploads exist once under an attachment ID",
        "Reference source is read once per attachment",
        "Reference rows stay behind a snapshot ID",
        "Each workbook revision gets an artifact ID",
        "No chat/shared workspace or baseline diff"
      ]
    },
    {
      "dot": "violet",
      "title": "Decision Boundary",
      "items": [
        "The model interprets bounded samples",
        "Application code owns every row decision",
        "Review mutations require explicit choices",
        "SQLite stores decisions and before/after audit"
      ]
    }
  ]
}
