{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Advisor Match LangGraph Workflow",
    "subtitle": "Bounded LLM routing and mapping around a deterministic matching core",
    "animation": "none",
    "visual_preset": "blueprint",
    "quality_profile": "showcase",
    "output": "docs/advisor_match_workflow.html",
    "viewBox": [820, 900]
  },
  "lanes": [
    { "id": "client", "label": "Chat UI + API" },
    { "id": "graph", "label": "LangGraph Control" },
    { "id": "core", "label": "Deterministic Core" },
    { "id": "review", "label": "Human Review", "variant": "exception" },
    { "id": "data", "label": "State + Evidence" }
  ],
  "phases": [
    { "id": "intake", "label": "Intake", "fromCol": 0, "toCol": 1 },
    { "id": "interpret", "label": "Interpret", "fromCol": 2, "toCol": 2, "variant": "emphasis" },
    { "id": "execute", "label": "Execute + review", "fromCol": 3, "toCol": 5, "variant": "security" }
  ],
  "groups": [
    { "id": "llm_boundary", "label": "Bounded LLM decisions", "lane": "graph", "fromCol": 1, "toCol": 2, "variant": "emphasis" },
    { "id": "policy_core", "label": "Code-owned identity policy", "lane": "core", "fromCol": 3, "toCol": 5, "variant": "security" }
  ],
  "mainPath": ["message", "router", "mapping", "validate", "match", "publish"],
  "nodes": [
    { "id": "message", "lane": "client", "col": 0, "type": "frontend", "label": "Message + File", "sublabel": "one CSV/XLSX" },
    { "id": "router", "lane": "graph", "col": 1, "type": "backend", "label": "Typed Router", "sublabel": "3 attempts max", "tag": "LLM" },
    { "id": "mapping", "lane": "core", "col": 2, "type": "backend", "label": "Map Input", "sublabel": "bounded profile", "tag": "LLM", "width": 100 },
    { "id": "validate", "lane": "graph", "col": 3, "type": "security", "label": "Validate", "sublabel": "limits + fingerprint" },
    { "id": "match", "lane": "core", "col": 4, "type": "security", "label": "Match + Score", "sublabel": "deterministic policy" },
    { "id": "publish", "lane": "client", "col": 5, "type": "backend", "label": "Workbook", "sublabel": "reply + events" },
    { "id": "interrupt", "lane": "review", "col": 1, "type": "messagebus", "label": "Interrupt", "sublabel": "ask + resume" },
    { "id": "decisions", "lane": "review", "col": 5, "type": "external", "label": "Review", "sublabel": "explicit choices" },
    { "id": "memory", "lane": "data", "col": 0, "type": "database", "label": "Memory", "sublabel": "restart loss" },
    { "id": "repository", "lane": "data", "col": 4, "type": "database", "label": "Audit DB", "sublabel": "durable evidence" }
  ],
  "edges": [
    { "id": "intake_route", "from": "message", "to": "router", "variant": "default" },
    { "id": "route_mapping", "from": "router", "to": "mapping", "variant": "emphasis" },
    { "id": "mapping_validate", "from": "mapping", "to": "validate", "variant": "default" },
    { "id": "validate_match", "from": "validate", "to": "match", "variant": "security" },
    { "id": "match_publish", "from": "match", "to": "publish", "variant": "security" },
    { "id": "clarify", "from": "mapping", "to": "interrupt", "variant": "dashed", "role": "branch" },
    { "id": "resume", "from": "interrupt", "to": "router", "variant": "dashed", "role": "return" },
    { "id": "review_apply", "from": "decisions", "to": "publish", "variant": "security", "role": "return" },
    { "id": "checkpoint", "from": "message", "to": "memory", "variant": "dashed" },
    { "id": "audit", "from": "match", "to": "repository", "variant": "dashed" },
    { "id": "review_request", "from": "publish", "to": "decisions", "variant": "dashed", "role": "branch" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Deterministic Authority",
      "items": [
        "Normalization, candidates, scores, decisions, and exports are code-owned",
        "The model never receives the complete reference or workbook",
        "Exact CRD and review invariants remain unchanged"
      ]
    },
    {
      "dot": "violet",
      "title": "LLM Boundary",
      "items": [
        "Router and mapping use strict structured output",
        "Three total attempts per decision",
        "No tools, planner, subagents, or autonomous loop"
      ]
    },
    {
      "dot": "amber",
      "title": "Restart Semantics",
      "items": [
        "Conversation and interrupt progress are process-local",
        "API restart begins a fresh conversation",
        "Durable advisor evidence remains for audit and download"
      ]
    }
  ]
}
