{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Advisor Match + Profile Report Workflow",
    "subtitle": "One bounded LangGraph routes matching and CRD-based placeholder reports",
    "output": "docs/advisor_match_workflow.html",
    "animation": "none",
    "visual_preset": "blueprint",
    "quality_profile": "showcase",
    "views": [
      { "id": "match-flow", "label": "Match and export", "focus": ["request", "route", "match", "workbook"], "note": "Follow deterministic matching through verified workbook publication." },
      { "id": "direct-profile", "label": "Direct profile report", "focus": ["request", "route", "profile_source", "generate_report", "persist_report", "preview"], "note": "A CRD-bearing upload reaches report generation after exact column validation." },
      { "id": "post-match-profile", "label": "Post-match handoff", "focus": ["workbook", "profile_source", "generate_report", "persist_report", "preview"], "note": "Only automatically matched CRDs flow into the one-click report action." },
      { "id": "clarification", "label": "Resolve ambiguity", "focus": ["profile_source"], "note": "Ambiguous worksheets, headers, or columns pause through the existing interrupt before preparation completes." }
    ]
  },
  "lanes": [
    { "id": "user", "label": "User + Streamlit" },
    { "id": "control", "label": "LangGraph Control" },
    { "id": "matching", "label": "Advisor Matching" },
    { "id": "storage", "label": "Protected Persistence" },
    { "id": "profile", "label": "Profile Report" },
    { "id": "output", "label": "Preview + Download" },
    { "id": "exception", "label": "Clarification", "variant": "exception" }
  ],
  "mainPath": ["request", "route", "match", "workbook"],
  "nodes": [
    { "id": "request", "lane": "user", "col": 0, "type": "frontend", "label": "Request", "sublabel": "prompt or button", "width": 80 },
    { "id": "route", "lane": "control", "col": 1, "type": "backend", "label": "Route", "sublabel": "UI hint or intent", "tag": "typed", "width": 80 },
    { "id": "match", "lane": "matching", "col": 2, "type": "security", "label": "Match", "sublabel": "map + code policy", "width": 80 },
    { "id": "workbook", "lane": "storage", "col": 3, "type": "database", "label": "Workbook", "sublabel": "immutable XLSX", "width": 80 },
    { "id": "profile_source", "lane": "profile", "col": 3, "type": "security", "label": "CRD Src", "sublabel": "validated", "width": 60 },
    { "id": "generate_report", "lane": "profile", "col": 4, "type": "backend", "label": "Build", "sublabel": "static HTML", "width": 60 },
    { "id": "persist_report", "lane": "storage", "col": 5, "type": "database", "label": "Persist", "sublabel": "scoped audit", "width": 80 },
    { "id": "preview", "lane": "output", "col": 5, "type": "frontend", "label": "Preview", "sublabel": "HTML + download", "width": 80 }
  ],
  "edges": [
    { "from": "request", "to": "route", "role": "main" },
    { "from": "route", "to": "match", "role": "main" },
    { "from": "match", "to": "workbook", "role": "main", "variant": "emphasis" },
    { "from": "route", "to": "profile_source", "role": "branch", "route": "return-left", "fromSide": "left", "toSide": "left" },
    { "from": "workbook", "to": "profile_source", "role": "branch", "variant": "emphasis" },
    { "from": "profile_source", "to": "generate_report", "role": "main", "route": "bottom-channel", "fromSide": "bottom", "toSide": "bottom" },
    { "from": "generate_report", "to": "persist_report", "role": "main", "variant": "security" },
    { "from": "persist_report", "to": "preview", "role": "main", "variant": "emphasis", "route": "outside-right", "fromSide": "right", "toSide": "right" }
  ],
  "cards": [
    { "dot": "cyan", "title": "Hybrid Routing", "items": ["Explicit UI actions bypass intent classification", "Natural language remains available", "Both workflows share one bounded StateGraph"] },
    { "dot": "emerald", "title": "Code-Owned Decisions", "items": ["The model sees only bounded upload profiles", "Matching and CRD extraction stay deterministic", "No shell, network, tools, or subagents are added"] },
    { "dot": "violet", "title": "Auditable Outputs", "items": ["Workbook and HTML artifacts are immutable", "Report sources and CRD counts are corporation scoped", "Only automatically matched CRDs enter post-match reports"] }
  ]
