# Required OpenAI model identifier; `openai:model` and plain model names work.
MODEL_NAME=openai:gpt-5.6-luna
MODEL_KWARGS_JSON={}

# Provider credentials. Only the variables required by your provider are needed.
OPENAI_API_KEY=your_openai_api_key_here

# Bind addresses are configurable for local development or EKS deployment.
API_HOST=127.0.0.1
API_PORT=8001
APP_HOST=127.0.0.1
APP_PORT=8502
API_BASE_URL=http://127.0.0.1:8001

# Logs are emitted to stdout/stderr for container collection.
LOG_LEVEL=INFO

# Upload and preview limits.
MAX_UPLOAD_MB=50
MAX_INSPECT_SHEETS=20
MAX_INSPECT_ROWS=50
MAX_INSPECT_COLUMNS=20

# Advisor matching limits. The initial source is the checked-in synthetic table.
ADVISOR_MAX_INPUT_ROWS=50000
ADVISOR_MAX_REFERENCE_ROWS=1000000
