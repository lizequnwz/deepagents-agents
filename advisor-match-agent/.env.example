# Required model identifier passed directly to langchain.init_chat_model.
MODEL_NAME=openai:gpt-5.6-luna
MODEL_KWARGS_JSON={}

# Provider credentials. Only the variables required by your provider are needed.
OPENAI_API_KEY=your_openai_api_key_here

# Loopback-only services.
API_HOST=127.0.0.1
API_PORT=8001
APP_HOST=127.0.0.1
APP_PORT=8502
API_BASE_URL=http://127.0.0.1:8001
DEFAULT_CORP_ID=A123456

# Show run diagnostics and technical UI details.
UI_DEBUG_MODE=false

# Human-readable API and agent log at .data/logs/api.log.
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Run timeout.
RUN_TIMEOUT_SECONDS=900

# Upload and preview limits.
MAX_UPLOAD_MB=100
MAX_INSPECT_SHEETS=20
MAX_INSPECT_ROWS=50
MAX_INSPECT_COLUMNS=20

# Advisor matching limits. The initial source is the checked-in synthetic table.
ADVISOR_MAX_INPUT_ROWS=50000
ADVISOR_MAX_REFERENCE_ROWS=1000000