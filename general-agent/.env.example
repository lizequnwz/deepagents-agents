# Required model identifier passed directly to langchain.init_chat_model.
MODEL_NAME=openai:gpt-6-luna
MODEL_KWARGS_JSON={}

# Provider credentials. Only the variables required by your provider are needed.
OPENAI_API_KEY=your_openai_api_key_here

# Loopback-only services.
API_HOST=127.0.0.1
API_PORT=8001
APP_HOST=127.0.0.1
APP_PORT=8502
API_BASE_URL=http://127.0.0.1:8001
DEFAULT_CORP_ID=A123456

# Trusted-host execution and run budgets.
COMMAND_TIMEOUT_SECONDS=120
RUN_TIMEOUT_SECONDS=900
MAX_COMMAND_OUTPUT_BYTES=100000
MAX_MODEL_CALLS=32
MAX_TOOL_CALLS=64
MAX_TASK_CALLS=12
MAX_RUN_TOKENS=1000000
MAX_FILE_READ_CHARS=20000
MAX_EVENT_OUTPUT_CHARS=12000

# Coding workbench: trusted host execution by default, no Docker required.
# Local commands have host permissions/network access; the source copy is not a sandbox.
CODING_RUNTIME=local
# Optional absolute TypeScript 5.9.3 lib/typescript.js path. Empty uses tooling/coding.
CODING_TYPESCRIPT_SDK=
# Local browser checks need the optional browser extra, Chromium and system lsof.
# Optional Docker mode requires explicit locally built images; no runtime fallback.
CODING_IMAGE=general-agent-coding:local
CODING_BROWSER_IMAGE=general-agent-coding-browser:local
# CPU/memory/PID/tmpfs containment applies only to Docker mode.
CODING_MEMORY_MB=1024
CODING_PIDS=128
CODING_STORAGE_MB=512
MAX_REPOSITORY_MB=50
MAX_REPOSITORY_FILES=5000
MAX_CODING_WORKERS=2

# Optional application-side connectors; credentials never enter coding commands.
# Review each project's documentation domains before fetch/search is available.
BRAVE_SEARCH_API_KEY=
# Map corporation IDs to GitHub tokens; see docs/CODING_CONNECTORS.md.
GITHUB_TOKENS_JSON={}
# Map corporation IDs to Snowflake read profiles; see docs/CODING_CONNECTORS.md.
SNOWFLAKE_CONNECTIONS_JSON={}

# Separate, opt-in billable inline suggestions for the local editor extension.
INLINE_MODEL_NAME=
INLINE_MODEL_KWARGS_JSON={}

# Upload and preview limits.
MAX_UPLOAD_FILES=10
MAX_UPLOAD_MB=100
MAX_INSPECT_PAGES=20
MAX_INSPECT_SHEETS=20
MAX_INSPECT_ROWS=50
MAX_INSPECT_COLUMNS=20
MAX_INSPECT_CHARS=50000

# Optional LangSmith tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=general-agent
