# Add your key, then run ./scripts/start.sh (it installs locked dependencies).
OPENAI_API_KEY=

# Model selection
MODEL_PROVIDER=openai
MODEL_ID=gpt-5.6-luna

# Execution review: false = run automatically; true = ask before executing.
REQUIRE_SQL_APPROVAL=false
REQUIRE_PYTHON_APPROVAL=false

# Optional warehouse registry; local file uploads work without a warehouse.
DATA_SOURCES_CONFIG=data_sources.yaml

# Run concurrency, budgets and timeouts (time values in seconds)
ANALYSIS_PARALLEL_WORKERS=2
ANALYSIS_BUDGET_SECONDS=900
PRESENTATION_BUDGET_SECONDS=120
SQL_TIMEOUT_SECONDS=10
ANALYSIS_PYTHON_TIMEOUT_SECONDS=120

# Tracing is optional. Supply your own LangSmith credentials if enabled.
LANGSMITH_TRACING=false

# Bedrock credentials, data/output limits, call limits and development options:
# doc/development/configuration.md
